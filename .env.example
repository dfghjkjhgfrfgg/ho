# Kalshi API Configuration
KALSHI_EMAIL=your.email@example.com
KALSHI_PASSWORD=your_password_here

# API URL (production or demo)
# Production: https://api.elections.kalshi.com/trade-api/v2
# Demo/Sandbox: https://demo.kalshi.com/trade-api/v2
KALSHI_API_URL=https://demo.kalshi.com/trade-api/v2

# Trading Parameters
MIN_EDGE=0.05                    # Minimum edge required (5%)
MAX_POSITION_SIZE=100            # Max $ per position
MAX_TOTAL_EXPOSURE=500           # Max total $ exposure across all positions
KELLY_FRACTION=0.25              # Kelly Criterion fraction (0.25 = quarter Kelly for safety)

# Market Categories (comma-separated)
# Examples: sports, nfl, nba, mlb, nhl, soccer, politics, weather, economics
CATEGORIES=sports,nfl,nba,mlb

# Execution
DRY_RUN=true                     # Set to false for live trading
SCAN_INTERVAL_MS=30000           # Scan interval in milliseconds (30000 = 30 seconds)

# Logging
LOG_LEVEL=info                   # Log level: error, warn, info, debug
