# =============================================
# SOLANA CRYPTO TRADING BOT - CONFIGURATION
# =============================================

# ========== BOT MODE ==========
# Options: LIVE, PAPER, BACKTEST
# LIVE = Real trading with real money (DANGER!)
# PAPER = Simulated trading for testing
# BACKTEST = Historical data analysis
BOT_MODE=PAPER

# ========== SOLANA NETWORK ==========
# Options: mainnet-beta, devnet, testnet
SOLANA_NETWORK=mainnet-beta

# RPC Endpoint (use premium RPC for better performance)
# Recommended: Helius, QuickNode, Alchemy
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# ========== WALLET CONFIGURATION ==========
# Your Solana wallet private key
# IMPORTANT: Keep this secure! Never share or commit to git!
# Format: Base58 string or [1,2,3,...] array format
# Leave empty for PAPER mode
WALLET_PRIVATE_KEY=

# ========== TRADING CONFIGURATION ==========
# Trading pairs (comma-separated)
# Example: SOL/USDC,RAY/USDC,BONK/USDC
TRADING_PAIRS=SOL/USDC

# Scan interval in milliseconds (how often to check for opportunities)
SCAN_INTERVAL=5000

# Minimum liquidity required (in USD)
MIN_LIQUIDITY=50000

# ========== TRADING STRATEGIES ==========
# Enable/disable individual strategies
ENABLE_RSI_STRATEGY=true
ENABLE_MACD_STRATEGY=true
ENABLE_BB_STRATEGY=true
ENABLE_EMA_STRATEGY=true
ENABLE_VOLUME_ANALYSIS=true
ENABLE_AI_SENTIMENT=true

# ========== RISK MANAGEMENT ==========
# Maximum position size per trade (USD)
MAX_POSITION_SIZE=1000

# Maximum portfolio percentage per trade (%)
MAX_PORTFOLIO_PERCENT=10

# Stop loss percentage (%)
STOP_LOSS_PERCENT=5

# Take profit percentage (%)
TAKE_PROFIT_PERCENT=10

# Trailing stop percentage (%)
TRAILING_STOP_PERCENT=3

# Maximum slippage tolerance (%)
MAX_SLIPPAGE=1

# Maximum daily loss limit (USD)
MAX_DAILY_LOSS=500

# Minimum risk/reward ratio (e.g., 2 = 1:2 risk/reward)
MIN_RISK_REWARD_RATIO=2

# Maximum number of open positions
MAX_OPEN_POSITIONS=5

# ========== AI CONFIGURATION ==========
# AI Provider: CLAUDE, OPENAI, or BOTH
AI_PROVIDER=CLAUDE

# Claude API Key (get from console.anthropic.com)
CLAUDE_API_KEY=

# OpenAI API Key (get from platform.openai.com)
OPENAI_API_KEY=

# ========== NOTIFICATIONS ==========
# Telegram Bot (get token from @BotFather)
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook
ENABLE_DISCORD=false
DISCORD_WEBHOOK=

# ========== DATABASE ==========
# Enable database for trade history
ENABLE_DATABASE=true

# Database type: POSTGRESQL or SQLITE
DATABASE_TYPE=SQLITE

# PostgreSQL connection string (only if using PostgreSQL)
# Example: postgresql://user:password@localhost:5432/trading_bot
DATABASE_URL=

# ========== LOGGING ==========
# Log level: error, warn, info, debug
LOG_LEVEL=info

# ========== API SERVER ==========
# API server port for web dashboard
API_PORT=3001

# =============================================
# SAFETY WARNINGS
# =============================================
# 1. NEVER use LIVE mode without thorough testing in PAPER mode first
# 2. Start with small position sizes and low risk parameters
# 3. Always use stop losses and position size limits
# 4. Monitor the bot regularly - automated trading carries significant risk
# 5. Only invest what you can afford to lose
# 6. Cryptocurrency trading is highly volatile and risky
# 7. This bot is provided as-is with no guarantees
# 8. Do your own research and understand the risks
#
# By using this bot, you acknowledge that you understand
# the risks and take full responsibility for any losses.
# =============================================
